{
  "$schema": "../schema/sections.schema.json",
  "version": "0.1.0",
  "$comment": "The vocabulary both implementations rename to (SC-001). Ids are canonical; each platform's former names and stored option values are mapped under platforms.<platform>.formerly, so its migration can be generated. Variants listed here are the selects that change a section's layout, and the styles a parent picks for a component, which has no fields file; every other field is in contract/fields. Visitor output and editor fields must match (SC-003). Drafted 08/10/2026 from inventories of salt-nextjs 0.11.0 and salt-wordpress 5.0.0.",
  "sections": [
    {
      "id": "hero",
      "label": "Hero",
      "tier": "core",
      "summary": "The page's opening band: eyebrow, heading, subheading, up to the contract's limit of buttons, and an image.",
      "variants": [
        {
          "field": "variant",
          "label": "Layout",
          "options": [
            {
              "value": "full-bleed",
              "label": "Full bleed"
            },
            {
              "value": "split",
              "label": "Split"
            },
            {
              "value": "stacked",
              "label": "Stacked"
            },
            {
              "value": "minimal",
              "label": "Minimal (text only)"
            }
          ],
          "default": "full-bleed"
        }
      ],
      "platforms": {
        "nextjs": {
          "status": "ships",
          "formerly": [
            {
              "name": "hero",
              "values": {
                "variant": {
                  "fullBleed": "full-bleed",
                  "split": "split",
                  "stacked": "stacked",
                  "minimal": "minimal"
                }
              }
            }
          ]
        },
        "wordpress": {
          "status": "partial",
          "formerly": [
            {
              "name": "hero"
            }
          ],
          "owes": "the stacked variant"
        }
      }
    },
    {
      "id": "rich-text",
      "label": "Rich text",
      "tier": "core",
      "summary": "Eyebrow, heading and a rich-text body, aligned left or centred.",
      "variants": [
        {
          "field": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "centre",
              "label": "Centred"
            }
          ],
          "default": "left"
        }
      ],
      "platforms": {
        "nextjs": {
          "status": "ships",
          "formerly": [
            {
              "name": "richText",
              "note": "Its alignment option values are mapped when field definitions land."
            }
          ]
        },
        "wordpress": {
          "status": "ships",
          "formerly": [
            {
              "name": "rich_text"
            },
            {
              "name": "intro",
              "note": "Eyebrow, heading, content and align: the same fields as rich-text, so intro folds into it."
