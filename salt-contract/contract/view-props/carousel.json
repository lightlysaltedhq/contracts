{
  "$schema": "../../schema/view-props.schema.json",
  "version": "1.0.0-rc.1",
  "section": "carousel",
  "data": [
    {
      "name": "eyebrow",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "eyebrow"
    },
    {
      "name": "heading",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "heading"
    },
    {
      "name": "intro",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "intro"
    },
    {
      "name": "label",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "label",
      "description": "The field as set; with no heading, it names the set (from:heading or label)."
    },
    {
      "name": "named",
      "kind": "boolean",
      "description": "True when the heading or the label is set. Without a name the markup draws a plain list rather than a carousel, so a swapped view sees the same case core does.",
      "from": "logic"
    },
    {
      "name": "source",
      "kind": "enum",
      "values": [
        "inline",
        "services",
        "case-studies",
        "testimonials",
        "posts",
        "team"
      ],
      "from": "field",
      "field": "source"
    },
    {
      "name": "cardStyle",
      "kind": "enum",
      "values": [
        "generic",
        "quote"
      ],
      "from": "field",
      "field": "cardStyle"
    },
    {
      "name": "cards",
      "kind": "list",
      "of": "card",
      "from": "collection",
      "field": "query",
      "description": "From the query, or from the inline cards field when the source is inline."
    }
  ],
  "platforms": {
    "nextjs": {
      "formerly": "CarouselBlockData",
      "owes": "named"
    },
    "wordpress": {
      "owes": "a view template that takes these props, split from the section's logic"
    }
  }
}
