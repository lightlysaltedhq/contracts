{
  "$schema": "../../schema/view-props.schema.json",
  "version": "0.1.0",
  "section": "stats",
  "data": [
    {
      "name": "heading",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "heading"
    },
    {
      "name": "intro",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "intro"
    },
    {
      "name": "columns",
      "kind": "enum",
      "values": [
        "2",
        "3",
        "4"
      ],
      "from": "field",
      "field": "columns"
    },
    {
      "name": "items",
      "kind": "list",
      "of": "stat",
      "from": "field",
      "field": "items"
    }
  ],
  "types": {
    "stat": {
      "props": [
        {
          "name": "icon",
          "kind": "icon",
          "nullable": true,
          "from": "field",
          "field": "items.icon"
        },
        {
          "name": "value",
          "kind": "text",
          "from": "logic",
          "field": "items.value",
          "description": "Never null: the logic drops a stat whose value cleans away (SC-009) or does not resolve, as Salt for Next.js's resolver does."
        },
        {
          "name": "suffix",
          "kind": "text",
          "nullable": true,
          "from": "field",
          "field": "items.suffix"
        },
        {
          "name": "label",
          "kind": "text",
          "nullable": true,
          "from": "field",
          "field": "items.label"
        }
      ]
    }
  },
  "platforms": {
    "nextjs": {
      "formerly": "StatsBlockData"
    },
    "wordpress": {
      "owes": "a view template that takes these props, split from the section's logic"
    }
  }
}
