          "from": "field",
          "field": "steps.image"
        },
        {
          "name": "title",
          "kind": "text",
          "from": "field",
          "field": "steps.title"
        },
        {
          "name": "text",
          "kind": "text",
          "nullable": true,
          "from": "field",
          "field": "steps.text"
        },
        {
          "name": "cta",
          "kind": "object",
          "of": "link",
          "nullable": true,
          "from": "field",
          "field": "steps.cta"
        }
      ]
