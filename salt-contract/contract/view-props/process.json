{
  "$schema": "../../schema/view-props.schema.json",
  "version": "0.1.0",
  "section": "process",
  "data": [
    {
      "name": "eyebrow",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "eyebrow"
    },
    {
      "name": "heading",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "heading"
    },
    {
      "name": "intro",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "intro"
    },
    {
      "name": "layout",
      "kind": "enum",
      "values": [
        "timeline",
        "cards"
      ],
      "from": "field",
      "field": "layout"
    },
    {
      "name": "steps",
      "kind": "list",
