{
  "$schema": "../../schema/view-props.schema.json",
  "version": "0.1.0",
  "section": "tabs",
  "data": [
    {
      "name": "eyebrow",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "eyebrow"
    },
    {
      "name": "heading",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "heading"
    },
    {
      "name": "intro",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "intro"
    },
    {
      "name": "label",
      "kind": "text",
      "nullable": true,
      "from": "field",
      "field": "label",
      "description": "The field as set; with no heading, it names the set (from:heading or label)."
    },
    {
      "name": "named",
      "kind": "boolean",
      "description": "True when the heading or the label is set. Without a name the markup draws the panels stacked, with no radio group, so a swapped view sees the same case core does.",
      "from": "logic"
    },
    {
      "name": "tabs",
      "kind": "list",
      "of": "tab",
      "from": "field",
      "field": "tabs"
    }
  ],
  "types": {
    "tab": {
      "props": [
        {
          "name": "id",
          "kind": "text",
          "description": "Stable per tab, for <anchor>__tab-<n> and its panel.",
          "from": "logic"
        },
        {
          "name": "label",
          "kind": "text",
          "from": "field",
          "field": "tabs.label"
        },
        {
          "name": "content",
          "kind": "rich-text",
          "from": "field",
          "field": "tabs.content",
          "nullable": true
        }
      ]
    }
  },
  "platforms": {
    "nextjs": {
      "formerly": "TabsBlockData",
      "owes": "named, and a tab's content as nullable"
    },
    "wordpress": {
      "owes": "a view template that takes these props, split from the section's logic"
    }
  }
}
