{
  "$schema": "../../schema/markup.schema.json",
  "version": "0.1.0",
  "id": "post",
  "kind": "view",
  "summary": "A blog post.",
  "root": {
    "element": "main",
    "attributes": {
      "id": "main",
      "tabindex": "-1"
    },
    "note": "Inside the document skeleton page.json draws once (section#landmarks)."
  },
  "elements": [
    {
      "role": "article",
      "element": "article",
      "classes": [
        "salt-post"
      ],
      "children": [
        {
          "role": "header",
          "element": "header",
          "classes": [
            "salt-post__header"
          ],
          "children": [
            {
              "role": "breadcrumb",
              "element": "nav",
              "classes": [
                "salt-post__breadcrumb"
              ],
              "attributes": {
                "aria-label": "from:labels.breadcrumb"
              },
              "optional": true,
              "when": "the site shows a breadcrumb",
              "children": [
                {
                  "role": "trail",
                  "element": "ol",
                  "attributes": {
                    "role": "list"
                  },
                  "children": [
                    {
                      "role": "crumb",
                      "element": "li",
                      "repeat": {
                        "from": "home (when a home page is published), the blog index, this post",
                        "min": 2,
                        "max": 3
                      },
                      "children": [
                        {
                          "role": "crumb-link",
                          "element": "a",
                          "attributes": {
                            "href": "from:crumb href",
                            "aria-current": {
                              "value": "page",
                              "when": "the last crumb, this post"
                            }
                          },
                          "text": "from:crumb title"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "role": "category",
              "element": "p",
              "classes": [
                "salt-post__category"
              ],
              "optional": true,
              "when": "the post's first topic heads an archive",
              "children": [
                {
                  "role": "category-link",
                  "element": "a",
                  "attributes": {
                    "href": "from:topic archive url"
                  },
                  "text": "from:topic title"
                }
              ]
            },
            {
              "role": "title",
              "element": "h1",
              "text": "from:post.title"
            },
            {
              "role": "meta",
              "element": "p",
              "classes": [
                "salt-post__meta"
              ],
              "optional": true,
              "when": "byline, date or reading time is shown",
              "children": [
                {
                  "role": "byline",
                  "element": "span",
                  "classes": [
                    "salt-post__byline"
                  ],
                  "optional": true,
                  "when": "the post has an author and the byline is on",
                  "text": "from:labels.byline, then the author's name",
                  "children": [
                    {
                      "role": "byline-link",
                      "element": "a",
                      "attributes": {
                        "href": "from:author archive url"
                      },
                      "text": "from:author name",
                      "optional": true,
                      "when": "the author has an archive; the name as text otherwise"
                    }
                  ]
                },
                {
                  "role": "date",
                  "element": "time",
                  "attributes": {
                    "datetime": "from:date (YYYY-MM-DD in the site's timezone)"
                  },
                  "text": "from:date, formatted",
                  "optional": true,
                  "when": "dated and the date is on"
                },
                {
                  "role": "read-time",
                  "element": "span",
                  "text": "from:labels.readTime (minutes)",
                  "optional": true,
                  "when": "the post has prose and reading time is on"
                }
              ]
            }
          ]
        },
        {
          "role": "media",
          "element": "div",
          "classes": [
            "salt-post__media"
          ],
          "optional": true,
          "when": "the post has a featured image and it is on",
          "children": [
            {
              "role": "image",
              "component": "media",
              "note": "Context content, filling the frame. The view's priority image (section#priority-media); the body's blocks are planned with the media claimed."
            }
          ]
        },
        {
          "role": "body",
          "component": "rich-text-body",
          "note": "Base level 1: body headings start at h2."
        },
        {
          "role": "footer",
          "element": "footer",
          "classes": [
            "salt-post__footer"
          ],
          "optional": true,
          "when": "tags, sharing or an author are shown",
          "children": [
            {
              "role": "tags",
              "element": "ul",
              "classes": [
                "salt-post__tags"
              ],
              "attributes": {
                "role": "list",
                "aria-label": "from:labels.tags"
              },
              "optional": true,
              "when": "filed under a topic that heads an archive",
              "children": [
                {
                  "role": "tag",
                  "element": "li",
                  "repeat": {
                    "from": "topics that head an archive, in the editor's order"
                  },
                  "children": [
                    {
                      "role": "tag-link",
                      "element": "a",
                      "attributes": {
                        "href": "from:topic archive url"
                      },
                      "text": "from:topic title"
                    }
                  ]
                }
              ]
            },
            {
              "role": "share",
              "component": "share-links",
              "optional": true,
              "when": "sharing is on"
            },
            {
              "role": "author",
              "component": "author-box",
              "optional": true,
              "when": "the author box is on"
            }
          ]
        }
      ]
    },
    {
      "role": "adjacent",
      "element": "nav",
      "classes": [
        "salt-post__adjacent"
      ],
      "attributes": {
        "aria-label": "from:labels.adjacent"
      },
      "optional": true,
      "when": "a newer or older post exists",
      "note": "Outside the article: the way to the next post is not part of this one.",
      "children": [
        {
          "role": "adjacent-list",
          "element": "ul",
          "attributes": {
            "role": "list"
          },
          "children": [
            {
              "role": "neighbour",
              "element": "li",
              "attributes": {
                "data-direction": {
                  "enum": [
                    "newer",
                    "older"
                  ]
                }
              },
              "repeat": {
                "from": "newer, then older",
                "min": 1,
                "max": 2
              },
              "children": [
                {
                  "role": "neighbour-link",
                  "element": "a",
                  "attributes": {
                    "href": "from:neighbour url"
                  },
                  "children": [
                    {
                      "role": "adjacent-label",
                      "element": "span",
                      "classes": [
                        "salt-post__adjacent-label"
                      ],
                      "text": "from:labels.newer or labels.older"
                    },
                    {
                      "role": "neighbour-title",
                      "element": "span",
                      "text": "from:neighbour title",
                      "note": "A space between the two spans."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "headings": {
    "provides": "always",
    "level": "fixed",
    "fixedLevel": 1,
    "rules": [
      "section#single-h1"
    ],
    "role": "title"
  },
  "script": {
    "kind": "none"
  },
  "uses": [
    "rich-text-body",
    "media",
    "share-links",
    "author-box"
  ],
  "ruleRefs": [
    "section#landmarks",
    "section#single-h1"
  ],
  "notes": [
    {
      "topic": "ruling",
      "text": "The view body is the markup Salt for Next.js's example app writes (apps/example/src/site/blog-views.tsx, PostView), in its order, with its salt-post__* classes (SC-007). The author is the shared author-box component (salt-author-box*), not the example app's salt-post__author, salt-post__author-name, salt-post__author-role and salt-post__portrait, which SC-008 excludes from the adoption."
    },
    {
      "topic": "stylesheet-owes",
      "text": "The view body classes SC-007 adopts; the shared stylesheets style them (today only the example app's site.css does).",
      "classes": [
        "salt-post",
        "salt-post__header",
        "salt-post__breadcrumb",
        "salt-post__category",
        "salt-post__meta",
        "salt-post__byline",
        "salt-post__media",
        "salt-post__footer",
        "salt-post__tags",
        "salt-post__adjacent",
        "salt-post__adjacent-label"
      ]
    }
  ],
  "platforms": {
    "wordpress": {
      "formerly": [
        {
          "role": "root",
          "element": "main",
          "note": "single-post.php"
        }
      ],
      "owes": [
        "Write the same markup as above, element for element and class for class (SC-007): the article, its header with breadcrumb, category, title and meta, the media frame, the footer with tags, share links and author box, and the adjacent nav after the article."
      ]
    },
    "nextjs": {
      "formerly": [
        {
          "role": "author",
          "element": "aside",
          "classes": [
            "salt-post__author"
          ],
          "note": "apps/example blog-views.tsx draws the author inline; author-box.json records its migration"
        }
      ],
      "owes": [
        "Rename salt-post__author, salt-post__author-name, salt-post__author-role and salt-post__portrait to the author-box component's salt-author-box* markup (author-box.json, SC-008)."
      ]
    }
  },
  "dataAttributes": [
    {
      "name": "data-direction",
      "on": "neighbour",
      "values": [
        "newer",
        "older"
      ]
    }
  ],
  "priorityMedia": {
    "role": "image",
    "when": "the featured image is drawn",
    "rules": [
      "section#priority-media"
    ]
  }
}
