{
  "$schema": "../../schema/markup.schema.json",
  "version": "0.1.0",
  "id": "locations",
  "kind": "section",
  "tier": "core",
  "root": {
    "element": "div",
    "classes": [
      "salt-block"
    ],
    "attributes": {
      "data-block": "locations"
    }
  },
  "elements": [
    {
      "role": "eyebrow",
      "component": "eyebrow",
      "optional": true,
      "when": "eyebrow is set"
    },
    {
      "role": "heading",
      "component": "heading",
      "attributes": {
        "id": "<anchor>__heading"
      },
      "optional": true,
      "when": "heading is set",
      "note": "Level from the plan (section#heading-level)."
    },
    {
      "role": "offices",
      "element": "div",
      "classes": [
        "salt-accordion",
        "salt-locations"
      ],
      "optional": true,
      "when": "an office has a title",
      "children": [
        {
          "role": "office",
          "element": "details",
          "classes": [
            "salt-accordion__item"
          ],
          "attributes": {
            "name": {
              "value": "locations-<section index>",
              "note": "<section index> is the section's place on the page, counted from 1."
            }
          },
          "repeat": {
            "from": "offices",
            "min": 1
          },
          "children": [
            {
              "role": "summary",
              "element": "summary",
              "classes": [
                "salt-accordion__summary"
              ],
              "children": [
                {
                  "role": "name",
                  "element": "span",
                  "classes": [
                    "salt-locations__name"
                  ],
                  "text": "from:office.title",
                  "note": "Not a heading."
                },
                {
                  "role": "status",
                  "element": "span",
                  "classes": [
                    "salt-locations__status"
                  ],
                  "attributes": {
                    "data-status": {
                      "enum": [
                        "open",
                        "appointment",
                        "closed"
                      ],
                      "note": "The server's status at render; the script replaces it on load."
                    },
                    "data-hours": {
                      "value": "from:office hours, as JSON",
                      "note": "The format is in the ruling note on open-now."
                    },
                    "data-timezone": {
                      "value": "from:the site's IANA timezone",
                      "note": "An IANA zone name, such as Europe/London, never an offset, so the script honours daylight saving."
                    },
                    "data-labels": {
                      "value": "from:labels, as JSON",
                      "note": "A JSON object of the three status labels, keyed open, appointment and closed, so the script writes the site's words."
                    }
                  },
                  "text": "from:labels.status",
                  "optional": true,
                  "when": "the office has hours (unknown status draws none)"
                }
              ]
            },
            {
              "role": "content",
              "element": "div",
              "classes": [
                "salt-accordion__content"
              ],
              "children": [
                {
                  "role": "office-body",
                  "element": "div",
                  "classes": [
                    "salt-locations__office"
                  ],
                  "children": [
                    {
                      "role": "address",
                      "element": "address",
                      "classes": [
                        "salt-locations__address"
                      ],
                      "optional": true,
                      "when": "an address line is set",
                      "children": [
                        {
                          "role": "line",
                          "element": "span",
                          "classes": [
                            "salt-locations__line"
                          ],
                          "repeat": {
                            "from": "non-empty address lines"
                          }
                        }
                      ]
                    },
                    {
                      "role": "contact",
                      "element": "ul",
                      "classes": [
                        "salt-locations__contact"
                      ],
                      "attributes": {
                        "role": "list"
                      },
                      "optional": true,
                      "when": "phone or email is set",
                      "children": [
                        {
                          "role": "contact-item",
                          "element": "li",
                          "repeat": {
                            "from": "tel, mailto",
                            "max": 2
                          },
                          "children": [
                            {
                              "role": "contact-link",
                              "element": "a",
                              "attributes": {
                                "href": "from:tel or mailto"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "role": "hours",
                      "component": "opening-hours",
                      "optional": true,
                      "when": "hours are set"
                    },
                    {
                      "role": "map",
                      "component": "map",
                      "optional": true,
                      "when": "maps are on and the office has coordinates"
                    },
                    {
                      "role": "directions",
                      "element": "a",
                      "classes": [
                        "salt-locations__directions"
                      ],
                      "attributes": {
                        "href": "from:directions url",
                        "aria-label": "from:labels.directions (office name)"
                      },
                      "text": "from:labels.getDirections",
                      "optional": true,
                      "when": "an address is set"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "headings": {
    "provides": "when heading is set",
    "role": "heading",
    "level": "plan",
    "labelledBy": true,
    "rules": [
      "section#heading-level",
      "section#single-h1",
      "section#labelled-by"
    ],
    "children": "office names are summary text, not headings"
  },
  "zeroState": "Module off, or no office with a title.",
  "priorityMedia": {
    "role": null
  },
  "dataAttributes": [
    {
      "name": "data-status",
      "on": "status",
      "values": [
        "open",
        "appointment",
        "closed"
      ]
    },
    {
      "name": "data-hours",
      "on": "status",
      "values": "from:office hours, as JSON",
      "note": "The open-now ruling note gives the format."
    },
    {
      "name": "data-timezone",
      "on": "status",
      "values": "from:the site's IANA timezone"
    },
    {
      "name": "data-labels",
      "on": "status",
      "values": "from:labels, as JSON",
      "note": "{\"open\": \"…\", \"appointment\": \"…\", \"closed\": \"…\"}"
    }
  ],
  "script": {
    "kind": "progressive",
    "withoutScript": "The status the server rendered, which a cached page may hold past a change of hours.",
    "withScript": "On load, a small script recomputes each office's status from data-hours in data-timezone and rewrites data-status and the status text from data-labels, so a cached page corrects itself."
  },
  "ruleRefs": [
    "section#display-forms"
  ],
  "uses": [
    "section",
    "section-intro",
    "accordion",
    "opening-hours",
    "map",
    "eyebrow",
    "heading"
  ],
  "notes": [
    {
      "topic": "stylesheet-owes",
      "text": "New vocabulary from WordPress; no rules in the shared stylesheets yet. The office list reuses the accordion classes, as WordPress does.",
      "classes": [
        "salt-locations",
        "salt-locations__name",
        "salt-locations__status",
        "salt-locations__office",
        "salt-locations__address",
        "salt-locations__line",
        "salt-locations__contact",
        "salt-locations__directions"
      ]
    },
    {
      "topic": "ruling",
      "text": "Open-now (SC-007): the server renders the status, and the status span carries the office's hours (data-hours), the site's IANA timezone (data-timezone) and the status labels (data-labels), so a script recomputes the status on load. data-hours is a JSON array of rows, each {\"day\": \"monday\" to \"sunday\", \"open\": \"HH:MM\", \"close\": \"HH:MM\"} in 24-hour time, or {\"day\": …, \"appointment\": true}. Several rows on one day are split hours. A row whose close is at or before its open runs past midnight: it covers open to midnight on its day and midnight to close on the next. The status at a moment, in data-timezone, is decided in this order, as salt-wordpress's salt_location_status() decides it. 1: today has an appointment row, so the status is appointment, whatever any row says. 2: a row of today's covers now, from open inclusive to close exclusive (for a row past midnight, from open to midnight), so open. 3: a row of yesterday's that runs past midnight covers now, from midnight to its close exclusive, so open, even when today has no rows; an appointment row on yesterday ignores yesterday's times, so carries nothing. 4: otherwise closed, which is what a day with no rows and no carried hours is. Worked example, with [{\"day\": \"friday\", \"open\": \"20:00\", \"close\": \"02:00\"}]: Saturday 01:00 is open (step 3, though Saturday has no rows); Saturday 02:00 is closed; and with {\"day\": \"saturday\", \"appointment\": true} added, Saturday 01:00 is appointment (step 1). Both the server and the script apply these rules, so they agree."
    }
  ],
  "platforms": {
    "nextjs": {
      "owes": [
        "The section, planned as Epic WP8, with the open-now status and its script (SC-007)."
      ]
    },
    "wordpress": {
      "formerly": [
        {
          "role": "eyebrow",
          "element": "p",
          "classes": [
            "x-eyebrow",
            "mb-2"
          ]
        },
        {
          "role": "heading",
          "element": "h1|h2",
          "classes": [
            "x-heading",
            "mb-6"
          ],
          "note": "No id; the WordPress section has no aria-labelledby."
        },
        {
          "role": "offices",
          "element": "div",
          "classes": [
            "x-locations",
            "flex",
            "flex-col"
          ],
          "attributes": [
            "data-section-component=locations"
          ]
        },
        {
          "role": "office",
          "element": "details",
          "classes": [
            "x-accordion-item"
          ]
        },
        {
          "role": "summary",
          "element": "summary",
          "classes": [
            "x-accordion-summary"
          ]
        },
        {
          "role": "name",
          "element": "span",
          "classes": [
            "text-lg",
            "font-semibold"
          ]
        },
        {
          "role": "status",
          "element": "span",
          "classes": [
            "x-status-pill",
            "text-success",
            "text-info"
          ],
          "attributes": [
            "data-status"
          ]
        },
        {
          "element": "span",
          "classes": [
            "x-accordion-chevron"
          ]
        },
        {
          "role": "content",
          "element": "div",
          "classes": [
            "x-accordion-content"
          ]
        },
        {
          "role": "office-body",
          "element": "div",
          "classes": [
            "x-location-card"
          ]
        },
        {
          "role": "address",
          "element": "address",
          "classes": [
            "not-italic"
          ]
        },
        {
          "role": "contact",
          "element": "ul",
          "classes": [
            "flex",
            "flex-col",
            "gap-1"
          ]
        },
        {
          "role": "directions",
          "element": "a",
          "classes": [
            "text-brand",
            "underline"
          ]
        }
      ],
      "owes": [
        "Write the block root div.salt-block with data-block set to the contract id inside the section wrapper (section.json).",
        "Give the section heading the id <anchor>__heading and point the wrapper's aria-labelledby at it (section#labelled-by, SC-012).",
        "Drop Tailwind utility classes from the markup; the shared stylesheets style the salt-* classes.",
        "Rename to the salt-locations vocabulary and salt-accordion classes; the outer list gains salt-accordion.",
        "Write data-hours, data-timezone and data-labels on the status span, and ship the script that recomputes the status on load (SC-007). Its stored appointment_only becomes appointment in data-hours."
      ]
    }
  }
}
