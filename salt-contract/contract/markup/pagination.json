{
  "$schema": "../../schema/markup.schema.json",
  "version": "1.0.0-rc.1",
  "id": "pagination",
  "kind": "component",
  "root": {
    "element": "nav",
    "classes": [
      "salt-pagination"
    ],
    "attributes": {
      "aria-label": "from:labels.nav"
    }
  },
  "elements": [
    {
      "role": "list",
      "element": "ul",
      "classes": [
        "salt-pagination__list"
      ],
      "attributes": {
        "role": "list"
      },
      "children": [
        {
          "role": "previous",
          "element": "li",
          "optional": true,
          "when": "current page > 1",
          "children": [
            {
              "role": "previous-link",
              "element": "a",
              "classes": [
                "salt-pagination__link"
              ],
              "attributes": {
                "data-step": "previous",
                "rel": "prev",
                "href": "from:href(current - 1)"
              },
              "text": "from:labels.previous"
            }
          ]
        },
        {
          "role": "page-first",
          "element": "li",
          "children": [
            {
              "role": "page-first-link",
              "element": "a",
              "classes": [
                "salt-pagination__link"
              ],
              "attributes": {
                "href": "from:href(n)",
                "aria-label": "from:labels.page",
                "aria-current": {
                  "value": "page",
                  "when": "n is the current page"
                }
              },
              "text": "from:n"
            }
          ],
          "note": "Page 1, always."
        },
        {
          "role": "gap-start",
          "element": "li",
          "classes": [
            "salt-pagination__gap"
          ],
          "attributes": {
            "aria-hidden": "true"
          },
          "text": "an ellipsis",
          "optional": true,
          "when": "pages between the first and the window are left out"
        },
        {
          "role": "page",
          "element": "li",
          "repeat": {
            "from": "the current page and its neighbours, and any page between them and the first or last that a one-page gap would leave out"
          },
          "children": [
            {
              "role": "page-link",
              "element": "a",
              "classes": [
                "salt-pagination__link"
              ],
              "attributes": {
                "href": "from:href(n)",
                "aria-label": "from:labels.page",
                "aria-current": {
                  "value": "page",
                  "when": "n is the current page"
                }
              },
              "text": "from:n"
            }
          ],
          "optional": true,
          "when": "the window has pages between the first and the last"
        },
        {
          "role": "gap-end",
          "element": "li",
          "classes": [
            "salt-pagination__gap"
          ],
          "attributes": {
            "aria-hidden": "true"
          },
          "text": "an ellipsis",
          "optional": true,
          "when": "pages between the window and the last are left out"
        },
        {
          "role": "page-last",
          "element": "li",
          "children": [
            {
              "role": "page-last-link",
              "element": "a",
              "classes": [
                "salt-pagination__link"
              ],
              "attributes": {
                "href": "from:href(n)",
                "aria-label": "from:labels.page",
                "aria-current": {
                  "value": "page",
                  "when": "n is the current page"
                }
              },
              "text": "from:n"
            }
          ],
          "optional": true,
          "when": "there are two pages or more",
          "note": "The last page, unless it is the first."
        },
        {
          "role": "next",
          "element": "li",
          "optional": true,
          "when": "current page < total",
          "children": [
            {
              "role": "next-link",
              "element": "a",
              "classes": [
                "salt-pagination__link"
              ],
              "attributes": {
                "data-step": "next",
                "rel": "next",
                "href": "from:href(current + 1)"
              },
              "text": "from:labels.next"
            }
          ]
        }
      ]
    }
  ],
  "headings": {
    "provides": "never",
    "level": "none"
  },
  "zeroState": "Not drawn when there is one page or none.",
  "dataAttributes": [
    {
      "name": "data-step",
      "on": "previous-link",
      "values": [
        "previous",
        "next"
      ]
    }
  ],
  "script": {
    "kind": "none"
  },
  "ruleRefs": [
    "section#focus-ring",
    "section#target-size",
    "section#landmarks"
  ],
  "hooks": [
    {
      "class": "salt-pagination",
      "role": "root",
      "reason": "Names the pagination landmark for sites and tests; its list and links carry the rules."
    }
  ],
  "notes": [
    {
      "topic": "order",
      "text": "The window is the first page, the last, and the current page with one neighbour each side; a run left out is one gap, and a gap of exactly one page is drawn as that page. So 5 of 9 is previous, 1, gap, 4, 5, 6, gap, 9, next, and 2 of 3 is previous, 1, 2, 3, next. Each page link's accessible name is labels.page with {n} replaced by the number (\"Page 2\"). Gaps sit only where the window skips, as the elements say."
    }
  ],
  "platforms": {
    "wordpress": {
      "formerly": [
        {
          "role": "root",
          "element": "nav",
          "classes": [
            "navigation",
            "pagination"
          ],
          "note": "the_posts_pagination(), WordPress core markup"
        }
      ],
      "owes": [
        "Pagination markup to the contract on archive and search templates.",
        "The same page window: first, last, current with one neighbour each side, a one-page gap drawn as the page, and an aria-hidden li.salt-pagination__gap for each longer run."
      ]
    }
  }
}
