{
  "$schema": "../../schema/markup.schema.json",
  "version": "1.0.0-rc.1",
  "id": "card",
  "kind": "component",
  "summary": "One card. The generic style serves services, case studies, posts, team, features and inline cards; the quote style serves testimonials.",
  "root": {
    "element": "div",
    "classes": [
      "salt-card"
    ]
  },
  "elements": [
    {
      "role": "media",
      "element": "div",
      "classes": [
        "salt-showcase__media"
      ],
      "optional": true,
      "when": "the card has an image",
      "children": [
        {
          "role": "image",
          "component": "media",
          "note": "fill, object-fit cover; context card, content for a lone or lead card."
        }
      ]
    },
    {
      "role": "icon",
      "component": "icon",
      "attributes": {
        "data-size": "lg"
      },
      "optional": true,
      "when": "icon is set and the card has no image"
    },
    {
      "role": "title",
      "component": "heading",
      "children": [
        {
          "role": "link",
          "element": "a",
          "classes": [
            "salt-card__link"
          ],
          "attributes": {
            "href": "from:href"
          },
          "optional": true,
          "when": "the item has its own page or a safe url",
          "children": [
            {
              "role": "arrow",
              "component": "arrow",
              "optional": true,
              "when": "the site supplies an arrow"
            }
          ],
          "note": "The one stretched link per card, wrapping the title."
        }
      ],
      "note": "Level given by the section: body base + 1."
    },
    {
      "role": "meta",
      "element": "p",
      "classes": [
        "salt-showcase__meta"
      ],
      "text": "from:meta",
      "optional": true,
      "when": "meta is set (client, role)"
    },
    {
      "role": "date",
      "element": "p",
      "classes": [
        "salt-showcase__meta"
      ],
      "optional": true,
      "when": "date is set",
      "children": [
        {
          "role": "time",
          "element": "time",
          "attributes": {
            "datetime": "from:date (YYYY-MM-DD)"
          }
        }
      ]
    },
    {
      "role": "text",
      "element": "p",
      "classes": [
        "salt-showcase__text"
      ],
      "text": "from:text",
      "optional": true,
      "when": "text is set"
    },
    {
      "role": "body",
      "component": "rich-text-body",
      "optional": true,
      "when": "a features item has a body",
      "note": "Features cards draw a rich-text body where collection cards draw the text paragraph."
    },
    {
      "role": "contact",
      "element": "ul",
      "classes": [
        "salt-showcase__contact"
      ],
      "attributes": {
        "role": "list"
      },
      "optional": true,
      "when": "a team member has an email, or a phone that normalises to a tel: link",
      "children": [
        {
          "role": "contact-email",
          "element": "li",
          "optional": true,
          "when": "email is set",
          "children": [
            {
              "role": "email-link",
              "element": "a",
              "attributes": {
                "href": "from:mailto"
              },
              "text": "from:email"
            }
          ]
        },
        {
          "role": "contact-phone",
          "element": "li",
          "optional": true,
          "when": "phone normalises to a tel: link",
          "children": [
            {
              "role": "phone-link",
              "element": "a",
              "attributes": {
                "href": "from:tel"
              },
              "text": "from:phone"
            }
          ]
        }
      ]
    },
    {
      "role": "socials",
      "element": "ul",
      "classes": [
        "salt-showcase__socials"
      ],
      "attributes": {
        "role": "list",
        "aria-label": "from:labels.social"
      },
      "optional": true,
      "when": "a team member has social profiles",
      "children": [
        {
          "role": "social-item",
          "element": "li",
          "repeat": {
            "from": "profiles"
          },
          "children": [
            {
              "role": "social-link",
              "element": "a",
              "classes": [
                "salt-showcase__social-link"
              ],
              "attributes": {
                "href": "from:profile url"
              },
              "children": [
                {
                  "role": "social-icon",
                  "component": "icon",
                  "attributes": {
                    "role": "img",
                    "aria-label": "from:profile name"
                  },
                  "optional": true,
                  "when": "a glyph exists for the profile"
                },
                {
                  "role": "social-name",
                  "element": "span",
                  "text": "from:profile name",
                  "optional": true,
                  "when": "no glyph exists for the profile"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "role": "results",
      "element": "ul",
      "classes": [
        "salt-grid",
        "salt-showcase__results"
      ],
      "attributes": {
        "role": "list",
        "aria-label": "from:labels.results",
        "data-columns": {
          "value": "2",
          "when": "two or fewer results"
        }
      },
      "optional": true,
      "when": "the lead card of a featured case-studies showcase has results",
      "children": [
        {
          "role": "result",
          "component": "stat",
          "repeat": {
            "from": "results"
          }
        }
      ]
    },
    {
      "role": "tags",
      "element": "ul",
      "classes": [
        "salt-showcase__tags"
      ],
      "attributes": {
        "role": "list"
      },
      "optional": true,
      "when": "tags are shown and the card has some",
      "children": [
        {
          "role": "tag",
          "element": "li",
          "classes": [
            "salt-showcase__tag"
          ],
          "text": "from:tag.title",
          "repeat": {
            "from": "tags"
          }
        }
      ]
    }
  ],
  "variants": [
    {
      "field": "style",
      "sameOrder": false,
      "note": "The quote style is a figure with its own order; the style follows the source (testimonials are quotes) or the carousel's cardStyle.",
      "options": {
        "generic": {},
        "quote": {
          "root": {
            "element": "figure",
            "classes": [
              "salt-card",
              "salt-showcase__quote"
            ]
          },
          "tree": [
            {
              "role": "rating",
              "element": "p",
              "classes": [
                "salt-showcase__rating"
              ],
              "attributes": {
                "role": "img",
                "aria-label": "from:labels.rating ({n} of {N})"
              },
              "optional": true,
              "when": "rating is set (0-5)",
              "children": [
                {
                  "role": "stars",
                  "element": "span",
                  "classes": [
                    "salt-showcase__stars"
                  ],
                  "attributes": {
                    "aria-hidden": "true",
                    "style": "--salt-rating-fill: <percentage>"
                  },
                  "text": "five empty stars",
                  "children": [
                    {
                      "role": "stars-fill",
                      "element": "span",
                      "classes": [
                        "salt-showcase__stars-fill"
                      ],
                      "text": "five filled stars"
                    }
                  ]
                }
              ]
            },
            {
              "role": "quote",
              "element": "blockquote",
              "classes": [
                "salt-showcase__text"
              ],
              "children": [
                {
                  "role": "quote-text",
                  "element": "p",
                  "text": "from:text"
                }
              ]
            },
            {
              "role": "caption",
              "element": "figcaption",
              "classes": [
                "salt-showcase__caption"
              ],
              "children": [
                {
                  "role": "media",
                  "element": "div",
                  "classes": [
                    "salt-showcase__media"
                  ],
                  "optional": true,
                  "when": "the testimonial has a photo or logo",
                  "children": [
                    {
                      "role": "image",
                      "component": "media",
                      "note": "Decorative: alt empty, context thumb."
                    }
                  ]
                },
                {
                  "role": "title",
                  "component": "heading",
                  "text": "from:title (the person)",
                  "note": "Level given: body base + 1."
                },
                {
                  "role": "meta",
                  "element": "p",
                  "classes": [
                    "salt-showcase__meta"
                  ],
                  "text": "from:meta (role, company)",
                  "optional": true,
                  "when": "meta is set"
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "headings": {
    "provides": "always",
    "role": "title",
    "level": "given",
    "rules": [
      "section#body-heading-base"
    ]
  },
  "zeroState": "Not drawn without a title (quote: without the quote text).",
  "priorityMedia": {
    "role": "image",
    "when": "the section passes priority to its first card",
    "rules": [
      "section#priority-media"
    ]
  },
  "script": {
    "kind": "none"
  },
  "uses": [
    "arrow",
    "heading",
    "icon",
    "media",
    "rich-text-body",
    "stat"
  ],
  "ruleRefs": [
    "section#focus-ring",
    "section#list-semantics",
    "section#display-forms"
  ],
  "hooks": [
    {
      "class": "salt-showcase__results",
      "role": "results",
      "reason": "The case-study results list inside a lead card; salt-grid lays it out and salt-stat styles its items, but the list needs a name of its own for sites and tests."
    }
  ],
  "notes": [
    {
      "topic": "variant-order",
      "text": "The quote style changes the root element (figure) and its children's order; the generic style is the base."
    },
    {
      "topic": "stylesheet-owes",
      "text": "Team contact and social links (SC-006); no rules in the shared stylesheets yet. On a linked card they sit under its stretched a.salt-card__link, so the rules must lift them above it (position relative and a higher z-index) or they open the card's page instead.",
      "classes": [
        "salt-showcase__contact",
        "salt-showcase__socials",
        "salt-showcase__social-link"
      ]
    },
    {
      "topic": "ruling",
      "text": "The person in a quote card is named by a heading (SC-006), so a carousel of quotes has an outline. WordPress's testimonial card draws a span today."
    },
    {
      "topic": "ruling",
      "text": "Team cards carry optional email, phone and social links, each drawn only when filled (SC-006). They sit inside the card beside its stretched link, so the stylesheet lifts them above it."
    },
    {
      "topic": "ruling",
      "text": "One card element for every source: WordPress's article.x-card-* variants and their x-card-media and x-card-content wrappers go, and the stretched link is a.salt-card__link rather than an after: utility."
    }
  ],
  "platforms": {
    "nextjs": {
      "formerly": [
        {
          "role": "root",
          "element": "div",
          "classes": [
            "salt-card"
          ],
          "note": "Card plus the ShowcaseCard children from collection-showcase/section.tsx"
        }
      ],
      "owes": [
        "Team members' optional email, phone and social links, drawn on the card only when filled (SC-006)."
      ]
    },
    "wordpress": {
      "formerly": [
        {
          "role": "root",
          "element": "article",
          "classes": [
            "x-card",
            "x-card-service",
            "x-card-work",
            "x-card-post",
            "x-card-team",
            "x-card-feature",
            "group",
            "relative",
            "flex",
            "flex-col",
            "rounded-lg",
            "border"
          ]
        },
        {
          "role": "media",
          "element": "div",
          "classes": [
            "x-card-media",
            "x-card-service-icon",
            "x-card-feature-icon"
          ]
        },
        {
          "element": "div",
          "classes": [
            "x-card-content"
          ],
          "note": "Wrapper around title, meta and body; dropped."
        },
        {
          "role": "title",
          "element": "h",
          "classes": [
            "x-card-title"
          ]
        },
        {
          "role": "link",
          "element": "a",
          "classes": [
            "after:absolute",
            "after:inset-0"
          ]
        },
        {
          "role": "meta",
          "element": "div",
          "classes": [
            "x-card-meta",
            "x-card-work-client"
          ]
        },
        {
          "role": "date",
          "element": "time",
          "classes": [
            "x-card-post-date"
          ]
        },
        {
          "role": "text",
          "element": "p",
          "classes": [
            "x-card-body"
          ]
        },
        {
          "role": "root",
          "element": "figure",
          "classes": [
            "x-card-testimonial"
          ],
          "note": "Quote style"
        },
        {
          "role": "rating",
          "element": "div",
          "classes": [
            "x-card-testimonial-rating"
          ],
          "attributes": [
            "role=img",
            "aria-label"
          ]
        },
        {
          "role": "quote",
          "element": "blockquote",
          "classes": [
            "x-card-testimonial-quote",
            "x-scroll-carousel-quote"
          ]
        },
        {
          "role": "caption",
          "element": "figcaption",
          "classes": [
            "x-card-testimonial-attribution",
            "x-scroll-carousel-caption"
          ]
        },
        {
          "element": "div",
          "classes": [
            "x-card-testimonial-author",
            "x-scroll-carousel-name",
            "x-scroll-carousel-role"
          ],
          "note": "Name and role spans; the name becomes the title heading, the role the meta paragraph."
        },
        {
          "element": "div",
          "classes": [
            "x-scroll-carousel-card",
            "x-scroll-carousel-title",
            "x-scroll-carousel-text"
          ],
          "note": "The scroll carousel's own generic card; becomes this card."
        },
        {
          "element": "ul",
          "classes": [
            "x-card-team-contact",
            "x-card-team-socials"
          ],
          "note": "Team contact and social lists; become the contact and socials lists."
        }
      ],
      "owes": [
        "One div.salt-card (figure for quotes) with the order above; drop x-card-media and x-card-content wrappers.",
        "Rating as p.salt-showcase__rating with the two star spans, not five icons.",
        "Name the person in a quote card with a heading (SC-006).",
        "Team contact and social links as ul.salt-showcase__contact and ul.salt-showcase__socials, drawn only when filled."
      ]
    }
  }
}
