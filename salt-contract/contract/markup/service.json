{
  "$schema": "../../schema/markup.schema.json",
  "version": "1.0.0",
  "id": "service",
  "kind": "view",
  "summary": "A service page.",
  "root": {
    "element": "main",
    "attributes": {
      "id": "main",
      "tabindex": "-1"
    },
    "note": "Inside the document skeleton page.json draws once (section#landmarks)."
  },
  "elements": [
    {
      "role": "article",
      "element": "article",
      "classes": [
        "salt-service"
      ],
      "children": [
        {
          "role": "header",
          "element": "header",
          "classes": [
            "salt-service__header"
          ],
          "children": [
            {
              "role": "title",
              "element": "h1",
              "text": "from:service.title"
            },
            {
              "role": "summary",
              "element": "p",
              "classes": [
                "salt-service__summary"
              ],
              "text": "from:service.summary",
              "optional": true,
              "when": "summary is set"
            }
          ]
        },
        {
          "role": "intro",
          "element": "div",
          "classes": [
            "salt-service__intro"
          ],
          "optional": true,
          "when": "the introduction has words",
          "children": [
            {
              "role": "intro-body",
              "component": "rich-text-body",
              "note": "Base level 1: an editor's first heading is h2, level with the benefits heading."
            }
          ]
        },
        {
          "role": "benefits",
          "element": "section",
          "classes": [
            "salt-service__benefits"
          ],
          "attributes": {
            "aria-labelledby": "service__benefits-heading"
          },
          "optional": true,
          "when": "benefits are set",
          "children": [
            {
              "role": "benefits-heading",
              "element": "h2",
              "attributes": {
                "id": "service__benefits-heading"
              },
              "text": "from:labels.benefits"
            },
            {
              "role": "benefits-list",
              "element": "ul",
              "attributes": {
                "role": "list"
              },
              "children": [
                {
                  "role": "benefit",
                  "element": "li",
                  "repeat": {
                    "from": "benefits"
                  },
                  "text": "from:benefit"
                }
              ]
            }
          ]
        },
        {
          "role": "price",
          "element": "p",
          "classes": [
            "salt-service__price"
          ],
          "optional": true,
          "when": "priceFrom is set",
          "children": [
            {
              "role": "price-label",
              "element": "span",
              "classes": [
                "salt-service__price-label"
              ],
              "text": "from:labels.price"
            }
          ],
          "note": "The price follows the label as written, after a space, with no prefix: the field is a display value (£500, from £2,400, POA)."
        },
        {
          "role": "cta",
          "element": "p",
          "classes": [
            "salt-service__cta"
          ],
          "optional": true,
          "when": "a call to action resolves and has a label",
          "children": [
            {
              "role": "cta-button",
              "component": "button",
              "attributes": {
                "data-style": "primary"
              }
            }
          ]
        },
        {
          "role": "related",
          "element": "section",
          "classes": [
            "salt-related"
          ],
          "attributes": {
            "aria-labelledby": "service__related-heading"
          },
          "optional": true,
          "when": "related services exist",
          "children": [
            {
              "role": "related-heading",
              "element": "h2",
              "attributes": {
                "id": "service__related-heading"
              },
              "text": "from:labels.relatedServices"
            },
            {
              "role": "related-list",
              "element": "ul",
              "classes": [
                "salt-grid",
                "salt-showcase",
                "salt-related__list"
              ],
              "attributes": {
                "role": "list",
                "data-layout": "grid"
              },
              "children": [
                {
                  "role": "related-item",
                  "element": "li",
                  "repeat": {
                    "from": "related"
                  },
                  "children": [
                    {
                      "role": "related-card",
                      "component": "card",
                      "note": "Generic style, title at h3; never the priority image."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "headings": {
    "provides": "always",
    "level": "fixed",
    "fixedLevel": 1,
    "rules": [
      "section#single-h1"
    ],
    "role": "title"
  },
  "script": {
    "kind": "none"
  },
  "uses": [
    "rich-text-body",
    "button",
    "card"
  ],
  "ruleRefs": [
    "section#landmarks",
    "section#single-h1"
  ],
  "notes": [
    {
      "topic": "ruling",
      "text": "The view body is the markup Salt for Next.js's example app writes (apps/example/src/site/catalogue-views.tsx, ServiceView), in its order, with its salt-service__* and salt-related classes (SC-007). The related services sit inside the article, as Next draws them. The page draws no icon: the title names the service. The heading ids are service__benefits-heading and service__related-heading (SC-012)."
    },
    {
      "topic": "stylesheet-owes",
      "text": "The view body classes SC-007 adopts; the shared stylesheets style them (today only the example app's site.css does).",
      "classes": [
        "salt-service",
        "salt-service__header",
        "salt-service__summary",
        "salt-service__intro",
        "salt-service__benefits",
        "salt-service__price",
        "salt-service__price-label",
        "salt-service__cta",
        "salt-related",
        "salt-related__list"
      ]
    }
  ],
  "platforms": {
    "wordpress": {
      "formerly": [
        {
          "role": "root",
          "element": "main",
          "note": "single-service.php"
        }
      ],
      "owes": [
        "Write the same markup as above, element for element and class for class (SC-007): the article with its header, intro, benefits, price, call to action and related services."
      ]
    },
    "nextjs": {
      "formerly": [
        {
          "role": "benefits",
          "element": "section",
          "classes": [
            "salt-service__benefits"
          ],
          "note": "apps/example catalogue-views.tsx; unnamed today"
        },
        {
          "role": "related",
          "element": "section",
          "classes": [
            "salt-related"
          ],
          "note": "unnamed today"
        }
      ],
      "owes": [
        "Name the benefits and related sections: the ids service__benefits-heading and service__related-heading on their h2s, and aria-labelledby on each section (section#labelled-by).",
        "A related card's image declares the card slot for the full band at three columns (contract/image-sizes.json), the grid it is drawn in, which no shared stylesheet narrows; catalogue-views.tsx passes the unbanded card slot, which is a carousel slide's."
      ]
    }
  }
}
