{
  "$schema": "../../schema/markup.schema.json",
  "version": "1.0.0-rc.1",
  "id": "carousel",
  "kind": "section",
  "tier": "core",
  "root": {
    "element": "div",
    "classes": [
      "salt-block"
    ],
    "attributes": {
      "data-block": "carousel",
      "data-source": {
        "enum": [
          "inline",
          "services",
          "case-studies",
          "testimonials",
          "posts",
          "team"
        ]
      }
    }
  },
  "elements": [
    {
      "role": "eyebrow",
      "component": "eyebrow",
      "optional": true,
      "when": "eyebrow is set"
    },
    {
      "role": "heading",
      "component": "heading",
      "attributes": {
        "id": "<anchor>__heading"
      },
      "optional": true,
      "when": "heading is set",
      "note": "Level from the plan (section#heading-level)."
    },
    {
      "role": "intro",
      "element": "p",
      "classes": [
        "salt-intro"
      ],
      "text": "from:intro",
      "optional": true,
      "when": "intro is set"
    },
    {
      "role": "track",
      "component": "carousel-track",
      "attributes": {
        "aria-label": "from:heading or label"
      },
      "optional": true,
      "when": "a name (heading or label) and two or more cards",
      "note": "Each slide is a card."
    },
    {
      "role": "list",
      "element": "ul",
      "classes": [
        "salt-grid"
      ],
      "attributes": {
        "role": "list"
      },
      "optional": true,
      "when": "two or more cards and no name",
      "children": [
        {
          "role": "item",
          "element": "li",
          "repeat": {
            "from": "cards",
            "min": 2
          },
          "children": [
            {
              "role": "card",
              "component": "card"
            }
          ]
        }
      ]
    },
    {
      "role": "single",
      "component": "card",
      "optional": true,
      "when": "exactly one card"
    }
  ],
  "variants": [
    {
      "field": "cardStyle",
      "sameOrder": false,
      "options": {
        "generic": {
          "note": "Cards in the generic style."
        },
        "quote": {
          "note": "Cards in the quote style: figure root and its own order (card.json)."
        }
      },
      "note": "The style changes each card's root element and inner order; the section's own order is the same."
    }
  ],
  "headings": {
    "provides": "when heading is set",
    "role": "heading",
    "level": "plan",
    "labelledBy": true,
    "rules": [
      "section#heading-level",
      "section#single-h1",
      "section#labelled-by"
    ],
    "headingBeforeOwn": "no heading of its own and there are cards",
    "children": "card titles at body base + 1"
  },
  "zeroState": "The source is not installed or no card survives.",
  "priorityMedia": {
    "role": [
      "track",
      "list",
      "single"
    ],
    "when": "the first card's image (not for quotes), in the track, the unnamed list or a lone card, when the plan grants priority and the section has no renderable background",
    "rules": [
      "section#priority-media"
    ]
  },
  "dataAttributes": [
    {
      "name": "data-source",
      "on": "root",
      "values": [
        "inline",
        "services",
        "case-studies",
        "testimonials",
        "posts",
        "team"
      ]
    }
  ],
  "script": {
    "kind": "progressive",
    "withoutScript": "A scroll-snapping list (carousel-track).",
    "withScript": "Previous and next controls (carousel-track)."
  },
  "uses": [
    "section",
    "section-intro",
    "carousel-track",
    "card",
    "icon",
    "arrow",
    "media",
    "eyebrow",
    "heading"
  ],
  "ruleRefs": [
    "section#zero-state",
    "section#list-semantics"
  ],
  "notes": [
    {
      "topic": "variant-order",
      "text": "cardStyle changes the card element (div or figure) and its order, recorded in card.json."
    }
  ],
  "platforms": {
    "wordpress": {
      "formerly": [
        {
          "role": "eyebrow",
          "element": "p",
          "classes": [
            "x-eyebrow",
            "mb-2"
          ]
        },
        {
          "role": "heading",
          "element": "h1|h2",
          "classes": [
            "x-heading",
            "mb-6"
          ],
          "note": "No id; the WordPress section has no aria-labelledby."
        },
        {
          "role": "single",
          "element": "div",
          "classes": [
            "x-scroll-carousel-single",
            "x-testimonials-single",
            "max-w-2xl"
          ]
        }
      ],
      "owes": [
        "Write the block root div.salt-block with data-block set to the contract id inside the section wrapper (section.json).",
        "Give the section heading the id <anchor>__heading and point the wrapper's aria-labelledby at it (section#labelled-by, SC-012).",
        "Drop Tailwind utility classes from the markup; the shared stylesheets style the salt-* classes.",
        "One section for scroll_carousel and the testimonials slider, with collection sources; the label field; the unnamed list fallback."
      ]
    }
  }
}
