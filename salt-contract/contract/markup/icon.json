{
  "$schema": "../../schema/markup.schema.json",
  "version": "0.1.0",
  "id": "icon",
  "kind": "component",
  "root": {
    "element": "svg",
    "classes": [
      "salt-icon"
    ],
    "attributes": {
      "data-icon": "from:name",
      "data-size": {
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "viewBox": "0 0 24 24",
      "width": "24",
      "height": "24",
      "focusable": "false",
      "aria-hidden": {
        "value": "true",
        "when": "decorative (the default)"
      },
      "role": {
        "value": "img",
        "when": "not decorative"
      },
      "aria-label": {
        "value": "from:label",
        "when": "not decorative"
      },
      "fill": {
        "enum": [
          "none",
          "currentColor"
        ]
      },
      "stroke": {
        "enum": [
          "currentColor",
          "none"
        ]
      }
    }
  },
  "elements": [
    {
      "role": "path",
      "element": "path",
      "attributes": {
        "d": "from:glyph"
      },
      "repeat": {
        "from": "glyph paths",
        "min": 1
      }
    }
  ],
  "headings": {
    "provides": "never",
    "level": "none"
  },
  "zeroState": "Not drawn for an unknown or undrawable name (logged).",
  "dataAttributes": [
    {
      "name": "data-icon",
      "on": "root",
      "values": "from:name"
    },
    {
      "name": "data-size",
      "on": "root",
      "values": [
        "sm",
        "md",
        "lg"
      ]
    }
  ],
  "script": {
    "kind": "none"
  },
  "notes": [
    {
      "topic": "ruling",
      "text": "The svg is the element; WordPress's span.x-icon wrapper goes. Colour is currentColor only."
    },
    {
      "topic": "open-question",
      "text": "The two glyph sets differ (Next ships fifteen, WordPress twenty-five). The contract fixes the markup; which names ship is for the fixtures work item."
    }
  ],
  "platforms": {
    "wordpress": {
      "formerly": [
        {
          "role": "root",
          "element": "span",
          "classes": [
            "x-icon",
            "inline-flex",
            "size-4",
            "size-6",
            "size-8"
          ],
          "attributes": [
            "aria-hidden",
            "role=img",
            "aria-label"
          ]
        }
      ],
      "owes": [
        "Put class, data-icon, data-size and the naming on the svg itself."
      ]
    }
  }
}
