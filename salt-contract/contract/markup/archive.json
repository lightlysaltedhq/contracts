{
  "$schema": "../../schema/markup.schema.json",
  "version": "1.0.0-rc.9",
  "id": "archive",
  "kind": "view",
  "summary": "Archive and category pages: a listing with a heading.",
  "root": {
    "element": "main",
    "attributes": {
      "id": "main",
      "tabindex": "-1"
    },
    "note": "Inside the document skeleton page.json draws once (section#landmarks)."
  },
  "elements": [
    {
      "role": "header",
      "element": "header",
      "children": [
        {
          "role": "title",
          "element": "h1",
          "text": "from:archive or term title"
        },
        {
          "role": "description",
          "element": "p",
          "optional": true,
          "when": "the term has a description"
        }
      ]
    },
    {
      "role": "profile",
      "element": "div",
      "classes": [
        "salt-archive__profile"
      ],
      "optional": true,
      "when": "an author's page, which is a team member's own page (the founder's ruling of 19/11/2026), on its first page, with any of its details: a photo, a role, a bio, an email, a phone that normalises to a tel: link, or social profiles",
      "children": [
        {
          "role": "portrait",
          "element": "div",
          "classes": [
            "salt-archive__portrait"
          ],
          "optional": true,
          "when": "the photo resolves",
          "children": [
            {
              "role": "portrait-image",
              "component": "media",
              "note": "Context thumb, filling the frame; lazy."
            }
          ]
        },
        {
          "role": "strapline",
          "element": "p",
          "classes": [
            "salt-archive__strapline"
          ],
          "text": "from:the member's role",
          "optional": true,
          "when": "the role is set"
        },
        {
          "role": "bio",
          "element": "p",
          "classes": [
            "salt-archive__bio"
          ],
          "text": "from:the member's bio",
          "optional": true,
          "when": "the bio is set"
        },
        {
          "role": "contact",
          "element": "ul",
          "classes": [
            "salt-showcase__contact"
          ],
          "attributes": {
            "role": "list"
          },
          "optional": true,
          "when": "the member has an email, or a phone that normalises to a tel: link",
          "children": [
            {
              "role": "contact-email",
              "element": "li",
              "optional": true,
              "when": "email is set",
              "children": [
                {
                  "role": "email-link",
                  "element": "a",
                  "classes": [
                    "salt-showcase__contact-link"
                  ],
                  "attributes": {
                    "href": "from:mailto"
                  },
                  "text": "from:email"
                }
              ]
            },
            {
              "role": "contact-phone",
              "element": "li",
              "optional": true,
              "when": "phone normalises to a tel: link",
              "children": [
                {
                  "role": "phone-link",
                  "element": "a",
                  "classes": [
                    "salt-showcase__contact-link"
                  ],
                  "attributes": {
                    "href": "from:tel"
                  },
                  "text": "from:phone"
                }
              ]
            }
          ],
          "note": "As the team card draws it (card.json contact), with its classes."
        },
        {
          "role": "socials",
          "element": "ul",
          "classes": [
            "salt-showcase__socials"
          ],
          "attributes": {
            "role": "list",
            "aria-label": "from:labels.social"
          },
          "optional": true,
          "when": "the member has social profiles",
          "children": [
            {
              "role": "social-item",
              "element": "li",
              "repeat": {
                "from": "profiles"
              },
              "children": [
                {
                  "role": "social-link",
                  "element": "a",
                  "classes": [
                    "salt-showcase__social-link"
                  ],
                  "attributes": {
                    "href": "from:profile url"
                  },
                  "children": [
                    {
                      "role": "social-icon",
                      "component": "icon",
                      "attributes": {
                        "role": "img",
                        "aria-label": "from:profile name"
                      },
                      "optional": true,
                      "when": "a glyph exists for the profile"
                    },
                    {
                      "role": "social-name",
                      "element": "span",
                      "text": "from:profile name",
                      "optional": true,
                      "when": "no glyph exists for the profile"
                    }
                  ]
                }
              ]
            }
          ],
          "note": "As the team card draws it (card.json socials), with its classes; the network is derived from each address (contract/socials.json)."
        }
      ]
    },
    {
      "role": "listing",
      "component": "section",
      "note": "The listing section (listing.json), with its card list and pagination; its heading, if any, is h2.",
      "optional": true,
      "when": "always, except on an author's page whose member has no posts, where nothing is drawn in its place: no heading and no empty message (the founder's ruling of 19/11/2026). A topic's archive with no posts draws the listing's own empty state."
    }
  ],
  "headings": {
    "provides": "always",
    "level": "fixed",
    "fixedLevel": 1,
    "rules": [
      "section#single-h1"
    ],
    "role": "title"
  },
  "script": {
    "kind": "none"
  },
  "uses": [
    "section",
    "pagination",
    "card",
    "media",
    "icon"
  ],
  "ruleRefs": [
    "section#landmarks",
    "section#single-h1"
  ],
  "notes": [
    {
      "topic": "ruling",
      "text": "A topic has no profile, and later pages draw none. A user marked as a team member has one public profile at /team/{slug}/, whether or not they have written posts. The title comes first, then role as strapline, bio, photo and public contact links when filled, then any authored posts. The profile self-canonicalises; only its canonical URL appears in the sitemap. Team cards, bylines and author boxes link directly there. Existing author addresses for that profile permanently redirect there (301); they never serve duplicate content. An unticked author is credited as text and has no public profile (19/11/2026)."
    }
  ],
  "platforms": {
    "wordpress": {
      "formerly": [
        {
          "role": "header",
          "element": "header",
          "classes": [
            "x-archive-header"
          ]
        },
        {
          "element": "div",
          "classes": [
            "x-archive-description"
          ]
        }
      ],
      "owes": [
        "The listing section in place of native loops (listing.json).",
        "Write the same markup as above, element for element and class for class (SC-007), the author's profile included."
      ]
    },
    "nextjs": {
      "formerly": [
        {
          "role": "root",
          "element": "main",
          "note": "apps/example ArchiveView; salt-blog__list, salt-archive__profile"
        }
      ],
      "owes": [
        "Wrap the title in header, with the term's description when it has one; draw the posts through the listing section (listing.json) in place of ul.salt-blog__list."
      ]
    }
  }
}
