{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sections.schema.json",
  "title": "The Salt contract's section, component and view vocabulary",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "sections",
    "components",
    "views"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "field",
        "options",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "default": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "linked": {
          "type": "boolean",
          "description": "Whether each item has its own page, so a card can link to it."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "former": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The slug, layout, file or component name this platform used before the contract."
        },
        "when": {
          "type": "string",
          "description": "A condition on the former content, when only some of it maps here."
        },
        "values": {
          "type": "object",
          "description": "Former stored option value to the contract's, per variant field.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/id"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ships",
            "owes",
            "partial",
            "edge"
          ],
          "description": "ships: has it under a former name or this one; owes: does not have it yet; partial: has it with options missing; edge: may offer it only outside core, as a recipe."
        },
        "formerly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/former"
          }
        },
        "owes": {
          "type": "string",
          "description": "What this platform must add or change to conform."
        }
      }
    },
    "platforms": {
      "type": "object",
      "required": [
        "nextjs",
        "wordpress"
      ],
      "additionalProperties": false,
      "properties": {
        "nextjs": {
          "$ref": "#/$defs/platform"
        },
        "wordpress": {
          "$ref": "#/$defs/platform"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "label",
        "platforms"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "tier": {
          "enum": [
            "core",
            "edge"
          ]
        },
        "summary": {
          "type": "string"
        },
        "variants": {
          "description": "On a section, the selects in its fields file that change its layout; the gate checks each against that select. On a component, which has no fields file, the styles its parent passes; the gate checks the component's markup describes only these options.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "platforms": {
          "$ref": "#/$defs/platforms"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "description": "A field name, as in contract/fields: camelCase ASCII."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/entry"
          },
          {
            "required": [
              "tier"
            ]
          }
        ]
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "question": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "affects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    }
  }
}
