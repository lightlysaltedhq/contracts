{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "markup.schema.json",
  "title": "The Salt contract's markup for one section, component or view",
  "description": "Element order, the salt-* class vocabulary, data attributes and heading rules both implementations render (SC-003). One file per id in contract/sections.json. Rules stated once live in contract/markup/section.json under `rules`; every other file refers to them by `section#<rule>` rather than restating them.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "id",
    "kind"
  ],
  "anyOf": [
    {
      "required": [
        "root"
      ]
    },
    {
      "required": [
        "fragment"
      ],
      "properties": {
        "fragment": {
          "const": true
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "role": {
      "description": "A stable name for one element in the tree, unique within the file. Variants, headings, priority media and data attributes point at elements by role.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "className": {
      "description": "A class from the contract's vocabulary: salt-<block>, salt-<block>__<element> or salt-<block>__<element>--<modifier>.",
      "type": "string",
      "pattern": "^salt-[a-z0-9]+(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "formerClass": {
      "description": "A class a platform writes today. Free text, since WordPress's include Tailwind utilities.",
      "type": "string",
      "minLength": 1
    },
    "element": {
      "description": "An HTML tag, or the alternatives a condition chooses between (each alternative's condition is in `when` or `note`).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        }
      ]
    },
    "condition": {
      "description": "The field or condition that decides it, in words a reviewer can check against a fixture.",
      "type": "string",
      "minLength": 1
    },
    "attributeValue": {
      "description": "A literal value; `from:<field>` for a value read from content or the plan; an empty string for a boolean attribute written with no value; or an object naming the allowed values and when the attribute is present.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "enum"
          ],
          "additionalProperties": false,
          "properties": {
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "when": {
              "$ref": "#/$defs/condition"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string"
            },
            "when": {
              "$ref": "#/$defs/condition"
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attributeValue"
      }
    },
    "root": {
      "type": "object",
      "required": [
        "element"
      ],
      "additionalProperties": false,
      "properties": {
        "element": {
          "$ref": "#/$defs/element"
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/className"
          }
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "repeat": {
      "type": "object",
      "required": [
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "The list the element repeats over."
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "role"
      ],
      "anyOf": [
        {
          "required": [
            "element"
          ]
        },
        {
          "required": [
            "component"
          ]
        }
      ],
      "dependentRequired": {
        "optional": [
          "when"
        ]
      },
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "element": {
          "$ref": "#/$defs/element"
        },
        "component": {
          "$ref": "#/$defs/id",
          "description": "A component from contract/sections.json rendered here; its own file gives its markup. `classes` and `attributes` on this node are what the parent adds to the component's root."
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/className"
          }
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        },
        "text": {
          "type": "string",
          "description": "The element's text content: a literal, or from:<field>."
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        },
        "optional": {
          "type": "boolean",
          "description": "true when the element may be absent; `when` says what decides it."
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "elementDiff": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "element": {
          "$ref": "#/$defs/element"
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/className"
          },
          "description": "The element's classes under this option, in full."
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        },
        "absent": {
          "const": true,
          "description": "The element is never drawn under this option."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "variantOption": {
      "description": "Only what differs from the base tree under this option.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "$ref": "#/$defs/elementDiff"
        },
        "elements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/role"
          },
          "additionalProperties": {
            "$ref": "#/$defs/elementDiff"
          }
        },
        "replace": {
          "description": "Roles whose whole subtree this option draws differently. Present only where the variant changes element order, which `sameOrder: false` on the variant records.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/role"
          },
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "tree": {
          "description": "The whole element tree under this option, where the variant changes the root element and its children. Only with `sameOrder: false`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "field",
        "sameOrder",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "sameOrder": {
          "type": "boolean",
          "description": "true when every option draws the same elements in the same order and differs only in attribute values and classes (section#variants-keep-order). false records a section that breaks that rule; `note` says why."
        },
        "options": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/variantOption"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ruleRef": {
      "type": "string",
      "pattern": "^section#[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "headings": {
      "type": "object",
      "required": [
        "provides",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "provides": {
          "type": "string",
          "pattern": "^(always|never|when .+)$",
          "description": "Whether this draws a heading that names the section: always, never, or when <field or condition>."
        },
        "role": {
          "$ref": "#/$defs/role",
          "description": "The element that is the naming heading."
        },
        "level": {
          "enum": [
            "plan",
            "given",
            "fixed",
            "none"
          ],
          "description": "plan: the page plan decides it (section#heading-level); given: the parent passes it; fixed: always `fixedLevel`; none: draws no heading of its own."
        },
        "fixedLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "labelledBy": {
          "type": "boolean",
          "description": "true when the section wrapper's aria-labelledby points at this heading's id (section#labelled-by)."
        },
        "headingBeforeOwn": {
          "type": "string",
          "description": "When a heading of any rank renders before this one's own (it then cannot claim h1)."
        },
        "children": {
          "type": "string",
          "description": "The level rule for headings nested inside: cards, steps, rows, rich-text bodies."
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleRef"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "priorityMedia": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "oneOf": [
            {
              "$ref": "#/$defs/role"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one image that may take eager loading and fetchpriority=high, or null for none."
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleRef"
          }
        }
      }
    },
    "dataAttribute": {
      "type": "object",
      "required": [
        "name",
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^data-[a-z][a-z0-9-]*$"
        },
        "on": {
          "$ref": "#/$defs/role"
        },
        "values": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ],
          "description": "The value vocabulary, or a from:<field> reference, or the empty string for a boolean attribute."
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "script": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "progressive"
          ]
        },
        "withoutScript": {
          "type": "string",
          "description": "What works with no JavaScript at all."
        },
        "withScript": {
          "type": "string",
          "description": "What script adds on top."
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "progressive"
          }
        }
      },
      "then": {
        "required": [
          "withoutScript",
          "withScript"
        ]
      }
    },
    "former": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "element": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formerClass"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "platformNotes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "formerly": {
          "type": "array",
          "description": "What this platform renders today, per contract role, so its migration can be generated.",
          "items": {
            "$ref": "#/$defs/former"
          }
        },
        "owes": {
          "type": "array",
          "description": "What this platform must change to conform.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/className"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named values the rule fixes, such as a size floor. Custom properties and lengths only, never a colour."
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An ordering the rule fixes."
        },
        "source": {
          "type": "string"
        }
      }
    },
    "note": {
      "description": "A note on a markup file. There is no open-question topic: SC-007 closed the last, and 1.0.0 ships with none.",
      "type": "object",
      "required": [
        "topic",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "enum": [
            "order",
            "variant-order",
            "stylesheet-only",
            "stylesheet-owes",
            "accessibility",
            "platform-difference",
            "ruling"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/className"
          }
        }
      }
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "description": "A field name, as in contract/fields: camelCase ASCII."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id",
      "description": "A section, component or view id from contract/sections.json."
    },
    "kind": {
      "enum": [
        "section",
        "component",
        "view"
      ]
    },
    "tier": {
      "enum": [
        "core",
        "edge"
      ]
    },
    "summary": {
      "type": "string"
    },
    "fragment": {
      "const": true,
      "description": "The component draws no element of its own; `elements` is a run of siblings inside its parent."
    },
    "root": {
      "$ref": "#/$defs/root"
    },
    "elements": {
      "type": "array",
      "description": "The ordered tree inside the root. Document order is array order; an element's children are in order too.",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "headings": {
      "$ref": "#/$defs/headings"
    },
    "zeroState": {
      "type": "string",
      "description": "When this renders nothing at all: no wrapper, no heading, no empty element."
    },
    "priorityMedia": {
      "$ref": "#/$defs/priorityMedia"
    },
    "dataAttributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataAttribute"
      }
    },
    "script": {
      "$ref": "#/$defs/script"
    },
    "uses": {
      "type": "array",
      "uniqueItems": true,
      "description": "Components this draws, each specified in its own file.",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "rules": {
      "type": "object",
      "description": "Rules stated once for every section, component and view (contract/markup/section.json only).",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    },
    "ruleRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "hooks": {
      "type": "array",
      "description": "Classes the contract keeps with no rule in the shared stylesheets: a stable hook for a site's own styles, a script or a test.",
      "items": {
        "type": "object",
        "required": [
          "class",
          "role",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "class": {
            "$ref": "#/$defs/className"
          },
          "role": {
            "$ref": "#/$defs/role"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "description": "Classes a platform writes today that the contract drops, with the reason.",
      "items": {
        "type": "object",
        "required": [
          "class",
          "platform",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "nextjs",
              "wordpress"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nextjs": {
          "$ref": "#/$defs/platformNotes"
        },
        "wordpress": {
          "$ref": "#/$defs/platformNotes"
        }
      }
    }
  }
}
