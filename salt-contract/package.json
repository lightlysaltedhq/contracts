{
  "name": "@lightlysaltedhq/salt-contract",
  "version": "1.0.0",
  "description": "The platform-neutral Salt contract: section and component vocabulary, field definitions, markup, the shared stylesheets, extension points and fixtures that Salt for Next.js and Salt for WordPress both conform to. Rules and markup, never brand values.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightlysaltedhq/contracts.git",
    "directory": "salt-contract"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "@lightlysaltedhq:registry": "https://registry.npmjs.org"
  },
  "files": [
    "contract",
    "schema",
    "styles",
    "fixtures",
    "normalise.mjs",
    "conformance.mjs",
    "emit",
    "README.md",
    "CHANGELOG.md",
    "RELEASE-POLICY.md",
    "LICENSE"
  ],
  "bin": {
    "salt-conformance": "./conformance.mjs"
  },
  "exports": {
    "./sections": "./contract/sections.json",
    "./fields/*": "./contract/fields/*.json",
    "./markup/*": "./contract/markup/*.json",
    "./schema/sections": "./schema/sections.schema.json",
    "./schema/field-definition": "./schema/field-definition.schema.json",
    "./schema/markup": "./schema/markup.schema.json",
    "./emit/payload": "./emit/payload.mjs",
    "./emit/acf": "./emit/acf.mjs",
    "./styles/*": "./styles/*",
    "./token-layer": "./contract/token-layer.json",
    "./schema/token-layer": "./schema/token-layer.schema.json",
    "./dials": "./contract/dials.json",
    "./schema/dials": "./schema/dials.schema.json",
    "./view-props/*": "./contract/view-props/*.json",
    "./schema/view-props": "./schema/view-props.schema.json",
    "./schema/replaced-logic": "./schema/replaced-logic.schema.json",
    "./normalise": "./normalise.mjs",
    "./conformance": "./conformance.mjs",
    "./fixtures/*": "./fixtures/*",
    "./image-sizes": "./contract/image-sizes.json",
    "./schema/image-sizes": "./schema/image-sizes.schema.json",
    "./package.json": "./package.json"
  },
  "keywords": [
    "salt",
    "contract",
    "design-system",
    "wordpress",
    "payload"
  ]
}
